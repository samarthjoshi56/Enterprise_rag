# Application Configuration
APP_NAME="Enterprise RAG"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# PostgreSQL Configuration
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="enterprise_rag"
# Async SQLAlchemy URL format: postgresql+asyncpg://user:password@host:port/dbname
POSTGRES_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/enterprise_rag"

# Qdrant Vector DB Configuration
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# Redis Cache & Memory Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"
