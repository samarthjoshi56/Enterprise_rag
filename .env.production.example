# -----------------------------------------------------------------------------
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Enterprise RAG Application (Free Public Web Deployment)
# -----------------------------------------------------------------------------

# Backend Application Configuration
APP_NAME="Enterprise RAG"
APP_ENV="production"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# 1. PostgreSQL (Supabase Free Tier / Neon Free Tier)
# Example Supabase URL: postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_URL="postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DB_NAME>?sslmode=require"

# 2. Qdrant Vector Database (Qdrant Cloud Free Tier)
# Example Qdrant URL: https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_URL="https://<YOUR-QDRANT-CLUSTER>.cloud.qdrant.io:6333"
QDRANT_API_KEY="<YOUR-QDRANT-API-KEY>"
QDRANT_COLLECTION_NAME="enterprise_documents"

# 3. Redis Cache (Upstash Redis Free Tier)
# Example Upstash URL: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL="rediss://default:<PASSWORD>@<HOST>.upstash.io:6379"
REDIS_CACHE_ENABLED=true
REDIS_CACHE_TTL=3600

# 4. LLM Provider (Google Gemini API Free Tier or OpenAI API)
GOOGLE_API_KEY="<YOUR-GOOGLE-GEMINI-API-KEY>"
LLM_PROVIDER="google"
LLM_MODEL_NAME="gemini-2.0-flash"

# Optional OpenAI Fallback
# OPENAI_API_KEY="<YOUR-OPENAI-API-KEY>"

# Frontend Configuration (Vercel)
# VITE_API_URL="https://<YOUR-RENDER-BACKEND-URL>.onrender.com"
